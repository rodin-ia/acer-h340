#!/bin/sh

# h340raidmon
# Acer Aspire easyStore H340 RAID / SMART LED monitor
#
# Physical bay mapping:
#
#   bay1 -> ata1
#   bay2 -> ata2
#   bay3 -> ata3
#   bay4 -> ata4
#
# LED states:
#
#   1. No disk
#        OFF
#
#   2. Disk physically present but removed from RAID / faulty
#        RED solid
#
#   3. Disk in RAID + SMART problem
#        PURPLE <-> RED, 1.0s period
#
#   4. Disk participating in RAID resync/rebuild
#        PURPLE <-> OFF, 1.0s period
#
#   5. Disk in RAID + SMART OK
#        PURPLE solid
#
#   6. Disk not in RAID + SMART problem
#        BLUE <-> RED, 1.0s period
#
#   7. Disk not in RAID + SMART OK
#        BLUE solid
#
# RAID sync_action:
#
#   resync
#       All active members are synchronizing.
#       All participating disks are shown PURPLE <-> OFF.
#
#   recover
#       A failed/missing member is being replaced.
#       The replacement target is shown PURPLE <-> OFF.
#
#   check
#       Consistency check only. It is NOT treated as rebuild.
#
#   repair
#       Consistency repair. It is NOT treated as rebuild.
#
#   reshape
#       Array reshape. It is treated as an active rebuild operation.
#
# SMART problem means:
#
#   - overall SMART health is not PASSED/OK
#   - a SMART attribute has WHEN_FAILED set
#   - ATA error count is greater than zero
#
# SMART results are cached for SMART_CACHE_AGE seconds.
#
# Logging:
#
#   logger -t h340raidmon
#
# Runtime:
#
#   /var/run/h340raidmon/
#
# Known RAID UUIDs:
#
#   /etc/h340raidmon/array-uuids

PATH=/usr/sbin:/usr/bin:/sbin:/bin

H340LED=/usr/bin/h340led
SMARTCTL=/usr/sbin/smartctl
MDADM=/usr/sbin/mdadm

BLOCK_BASE=/sys/class/block
MD_BASE=/sys/block

RUNTIME_DIR=/var/run/h340raidmon
CONFIG_DIR=/etc/h340raidmon
ARRAY_UUID_FILE=$CONFIG_DIR/array-uuids

POLL_INTERVAL=1
SMART_CACHE_AGE=15

REBUILD_PERIOD=1.0
SMART_BLINK_PERIOD=1.0

RUNNING=1

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------

log_msg()
{
    logger -t h340raidmon "$*"
}

log_error()
{
    logger -t h340raidmon -p daemon.err "$*"
}

# ----------------------------------------------------------------------
# Find current /dev/sdX for a physical ATA port.
# ----------------------------------------------------------------------

find_disk_for_ata()
{
    ata="$1"

    for d in "$BLOCK_BASE"/sd?; do
        [ -e "$d/device" ] || continue

        path=$(readlink -f "$d/device")

        case "$path" in
            *"/$ata/"*)
                echo "${d##*/}"
                return 0
                ;;
        esac
    done

    return 1
}

# ----------------------------------------------------------------------
# Get disk model.
# ----------------------------------------------------------------------

disk_model()
{
    dev="$1"

    "$SMARTCTL" -i "$dev" 2>/dev/null |
        awk -F: '
            /Device Model:/ {
                gsub(/^ +/, "", $2)
                print $2
                exit
            }

            /Product:/ {
                gsub(/^ +/, "", $2)
                print $2
                exit
            }
        '
}

# ----------------------------------------------------------------------
# Get disk serial.
# ----------------------------------------------------------------------

disk_serial()
{
    dev="$1"

    "$SMARTCTL" -i "$dev" 2>/dev/null |
        awk -F: '
            /Serial Number:/ {
                gsub(/^ +/, "", $2)
                print $2
                exit
            }
        '
}

# ----------------------------------------------------------------------
# Get SMART overall health.
# ----------------------------------------------------------------------

smart_health()
{
    dev="$1"

    "$SMARTCTL" -H "$dev" 2>/dev/null |
        awk '
            /SMART overall-health self-assessment test result:/ {
                sub(/^.*result:[[:space:]]*/, "")
                print
                exit
            }

            /SMART Health Status:/ {
                sub(/^.*Status:[[:space:]]*/, "")
                print
                exit
            }
        '
}

# ----------------------------------------------------------------------
# Check SMART attributes.
#
# A non-empty WHEN_FAILED field means the attribute has failed.
# ----------------------------------------------------------------------

smart_failed_attributes()
{
    dev="$1"

    "$SMARTCTL" -A "$dev" 2>/dev/null |
        awk '
            BEGIN {
                bad = 0
                when_failed_col = 0
            }

            /^ID[[:space:]]+ATTRIBUTE_NAME/ {
                for (i = 1; i <= NF; i++) {
                    if ($i == "WHEN_FAILED") {
                        when_failed_col = i
                        break
                    }
                }
                next
            }

            /^[[:space:]]*[0-9]+[[:space:]]/ {
                if ($0 ~ /FAILING_NOW/)
                    bad = 1

                if (when_failed_col > 0 &&
                    NF >= when_failed_col &&
                    $(when_failed_col) != "-") {
                    bad = 1
                }
            }

            END {
                print bad ? "BAD" : "OK"
            }
        '
}

# ----------------------------------------------------------------------
# Check SMART error log.
#
# Returns:
#
#   OK
#   ERRORS
#   ERRORS:<count>
# ----------------------------------------------------------------------

smart_error_log()
{
    dev="$1"

    output=$(
        "$SMARTCTL" -l error "$dev" 2>&1
    )

    count=$(
        printf '%s\n' "$output" |
            awk '
                /ATA Error Count:/ {
                    print $4
                    exit
                }
            '
    )

    case "$count" in
        0)
            echo "OK"
            return
            ;;

        "")
            ;;

        *)
            echo "ERRORS:$count"
            return
            ;;
    esac

    if printf '%s\n' "$output" |
        grep -qiE 'No Errors Logged|No Errors found'; then

        echo "OK"
        return
    fi

    if printf '%s\n' "$output" |
        grep -qE '^[[:space:]]*[0-9]+[[:space:]]+.*[Ss]tatus:'; then

        echo "ERRORS"
        return
    fi

    echo "OK"
}

# ----------------------------------------------------------------------
# Complete SMART classification.
# ----------------------------------------------------------------------

smart_status()
{
    dev="$1"

    health=$(smart_health "$dev")

    case "$health" in
        PASSED|OK)
            ;;
        *)
            echo "BAD_HEALTH"
            return
            ;;
    esac

    attributes=$(smart_failed_attributes "$dev")

    if [ "$attributes" = "BAD" ]; then
        echo "BAD_ATTRIBUTES"
        return
    fi

    errors=$(smart_error_log "$dev")

    case "$errors" in
        OK)
            echo "OK"
            ;;

        *)
            echo "BAD_ERRORLOG:$errors"
            ;;
    esac
}

# ----------------------------------------------------------------------
# Remember UUIDs of currently active md arrays.
# ----------------------------------------------------------------------

remember_array_uuids()
{
    mkdir -p "$CONFIG_DIR"

    tmp="$ARRAY_UUID_FILE.tmp"

    : > "$tmp"

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue

        uuid=$(cat "$md/md/uuid" 2>/dev/null)

        [ -n "$uuid" ] || continue

        printf '%s\n' "$uuid" >> "$tmp"
    done

    if [ -s "$tmp" ]; then
        sort -u "$tmp" > "$ARRAY_UUID_FILE"
    fi

    rm -f "$tmp"
}

# ----------------------------------------------------------------------
# Check whether a RAID UUID is known.
# ----------------------------------------------------------------------

known_array_uuid()
{
    uuid="$1"

    [ -n "$uuid" ] || return 1
    [ -f "$ARRAY_UUID_FILE" ] || return 1

    grep -Fxq "$uuid" "$ARRAY_UUID_FILE"
}

# ----------------------------------------------------------------------
# Get current md UUID for a disk.
# ----------------------------------------------------------------------

raid_uuid_for_disk()
{
    disk="$1"

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue

        for state_file in "$md"/md/dev-*/state; do
            [ -e "$state_file" ] || continue

            dev_dir=$(dirname "$state_file")
            dev_name=$(basename "$dev_dir")
            dev_name=${dev_name#dev-}

            case "$dev_name" in
                "$disk"|"$disk"[0-9]*)
                    cat "$md/md/uuid" 2>/dev/null
                    return 0
                    ;;
            esac
        done
    done

    return 1
}

# ----------------------------------------------------------------------
# Check disk/partitions for a known RAID superblock.
# ----------------------------------------------------------------------

disk_has_known_array_uuid()
{
    disk="$1"

    for dev in \
        "/dev/$disk" \
        /dev/"$disk"[0-9]*; do

        [ -b "$dev" ] || continue

        uuid=$(
            "$MDADM" --examine --export "$dev" 2>/dev/null |
                sed -n 's/^MD_UUID=//p' |
                head -n 1
        )

        [ -n "$uuid" ] || continue

        if known_array_uuid "$uuid"; then
            return 0
        fi
    done

    return 1
}

# ----------------------------------------------------------------------
# Check whether this disk is a current member of an md array.
#
# Prints:
#
#   ARRAY_NAME
#
# or nothing.
# ----------------------------------------------------------------------

find_md_for_disk()
{
    disk="$1"

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue

        for state_file in "$md"/md/dev-*/state; do
            [ -e "$state_file" ] || continue

            dev_dir=$(dirname "$state_file")
            dev_name=$(basename "$dev_dir")
            dev_name=${dev_name#dev-}

            case "$dev_name" in
                "$disk"|"$disk"[0-9]*)
                    basename "$md"
                    return 0
                    ;;
            esac
        done
    done

    return 1
}

# ----------------------------------------------------------------------
# Determine whether a disk is participating in recovery.
#
# For "resync":
#
#   Every active member is being synchronized.
#
# For "recover":
#
#   Prefer the device which is not yet in sync.
#
# For "reshape":
#
#   Treat active member as participating in the operation.
# ----------------------------------------------------------------------

disk_is_rebuilding()
{
    disk="$1"

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue

        action=$(cat "$md/md/sync_action" 2>/dev/null)

        case "$action" in
            resync)
                for state_file in "$md"/md/dev-*/state; do
                    [ -e "$state_file" ] || continue

                    dev_dir=$(dirname "$state_file")
                    dev_name=$(basename "$dev_dir")
                    dev_name=${dev_name#dev-}

                    case "$dev_name" in
                        "$disk"|"$disk"[0-9]*)
                            return 0
                            ;;
                    esac
                done
                ;;

            recover)
                for state_file in "$md"/md/dev-*/state; do
                    [ -e "$state_file" ] || continue

                    dev_dir=$(dirname "$state_file")
                    dev_name=$(basename "$dev_dir")
                    dev_name=${dev_name#dev-}

                    case "$dev_name" in
                        "$disk"|"$disk"[0-9]*)
                            # Replacement/spare device.
                            state=$(cat "$state_file" 2>/dev/null)

                            case "$state" in
                                *spare*|*replacement*)
                                    return 0
                                    ;;
                            esac

                            # A device with in_sync=0 is the
                            # recovery target.
                            in_sync=$(
                                cat "$dev_dir/in_sync" 2>/dev/null
                            )

                            if [ "$in_sync" = "0" ]; then
                                return 0
                            fi
                            ;;
                    esac
                done
                ;;

            reshape)
                for state_file in "$md"/md/dev-*/state; do
                    [ -e "$state_file" ] || continue

                    dev_dir=$(dirname "$state_file")
                    dev_name=$(basename "$dev_dir")
                    dev_name=${dev_name#dev-}

                    case "$dev_name" in
                        "$disk"|"$disk"[0-9]*)
                            return 0
                            ;;
                    esac
                done
                ;;
        esac
    done

    return 1
}

# ----------------------------------------------------------------------
# Get RAID state for one physical disk.
#
# Returns:
#
#   REBUILD
#   FAULTY
#   MEMBER
#   DROPPED
#   NONE
# ----------------------------------------------------------------------

raid_state_for_disk()
{
    disk="$1"

    if disk_is_rebuilding "$disk"; then
        echo "REBUILD"
        return 0
    fi

    found_member=0
    found_faulty=0

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue

        for state_file in "$md"/md/dev-*/state; do
            [ -e "$state_file" ] || continue

            dev_dir=$(dirname "$state_file")
            dev_name=$(basename "$dev_dir")
            dev_name=${dev_name#dev-}

            case "$dev_name" in
                "$disk"|"$disk"[0-9]*)

                    found_member=1

                    state=$(cat "$state_file" 2>/dev/null)

                    case "$state" in
                        *faulty*)
                            found_faulty=1
                            ;;
                        *blocked*)
                            found_faulty=1
                            ;;
                        *write_error*)
                            found_faulty=1
                            ;;
                    esac
                    ;;
            esac
        done
    done

    if [ "$found_faulty" -eq 1 ]; then
        echo "FAULTY"
        return 0
    fi

    if [ "$found_member" -eq 1 ]; then
        echo "MEMBER"
        return 0
    fi

    if disk_has_known_array_uuid "$disk"; then
        echo "DROPPED"
        return 0
    fi

    echo "NONE"
}

# ----------------------------------------------------------------------
# Refresh SMART cache.
#
# Cache:
#
#   timestamp|disk|status|health|attributes|errorlog
# ----------------------------------------------------------------------

refresh_smart_cache()
{
    bay="$1"
    disk="$2"

    dev="/dev/$disk"
    cache="$RUNTIME_DIR/smart$bay"

    health=$(smart_health "$dev")
    attributes=$(smart_failed_attributes "$dev")
    errors=$(smart_error_log "$dev")

    case "$health" in
        PASSED|OK)
            status="OK"
            ;;
        *)
            status="BAD_HEALTH"
            ;;
    esac

    if [ "$status" = "OK" ] &&
       [ "$attributes" = "BAD" ]; then

        status="BAD_ATTRIBUTES"
    fi

    case "$errors" in
        OK)
            ;;
        *)
            status="BAD_ERRORLOG:$errors"
            ;;
    esac

    timestamp=$(date +%s)

    printf '%s|%s|%s|%s|%s|%s\n' \
        "$timestamp" \
        "$disk" \
        "$status" \
        "$health" \
        "$attributes" \
        "$errors" > "$cache"
}

# ----------------------------------------------------------------------
# Get cached SMART status.
# ----------------------------------------------------------------------

get_smart_status()
{
    bay="$1"
    disk="$2"

    cache="$RUNTIME_DIR/smart$bay"
    now=$(date +%s)

    if [ -f "$cache" ]; then
        IFS='|' read -r timestamp cached_disk status health attributes errors \
            < "$cache"

        case "$timestamp" in
            ''|*[!0-9]*)
                timestamp=0
                ;;
        esac

        age=$((now - timestamp))

        if [ "$cached_disk" = "$disk" ] &&
           [ "$age" -ge 0 ] &&
           [ "$age" -lt "$SMART_CACHE_AGE" ]; then

            echo "$status"
            return
        fi
    fi

    refresh_smart_cache "$bay" "$disk"

    IFS='|' read -r timestamp cached_disk status health attributes errors \
        < "$cache"

    echo "$status"
}

# ----------------------------------------------------------------------
# Get desired LED state.
#
#   off
#   red
#   purple
#   blue
#   blink-purple 1.0
#   blink-purple-red 1.0
#   blink-blue-red 1.0
# ----------------------------------------------------------------------

desired_led()
{
    bay="$1"
    ata="$2"

    disk=$(find_disk_for_ata "$ata")

    # Physical disk absent.
    if [ -z "$disk" ]; then
        echo "off"
        return
    fi

    raid=$(raid_state_for_disk "$disk")

    # Rebuild/resync always has highest priority.
    if [ "$raid" = "REBUILD" ]; then
        echo "blink-purple $REBUILD_PERIOD"
        return
    fi

    # Disk is physically present but md marked it faulty.
    if [ "$raid" = "FAULTY" ]; then
        echo "red"
        return
    fi

    # Disk has been removed from the active array but still carries
    # the known RAID metadata.
    if [ "$raid" = "DROPPED" ]; then
        echo "red"
        return
    fi

    smart=$(get_smart_status "$bay" "$disk")

    case "$raid" in
        MEMBER)
            case "$smart" in
                OK)
                    echo "purple"
                    ;;
                *)
                    echo "blink-purple-red $SMART_BLINK_PERIOD"
                    ;;
            esac
            ;;

        NONE)
            case "$smart" in
                OK)
                    echo "blue"
                    ;;
                *)
                    echo "blink-blue-red $SMART_BLINK_PERIOD"
                    ;;
            esac
            ;;

        *)
            echo "off"
            ;;
    esac
}

# ----------------------------------------------------------------------
# Log SMART problem details.
# ----------------------------------------------------------------------

log_smart_problem()
{
    bay="$1"
    ata="$2"
    disk="$3"

    cache="$RUNTIME_DIR/smart$bay"

    [ -f "$cache" ] ||
        refresh_smart_cache "$bay" "$disk"

    IFS='|' read -r timestamp cached_disk status health attributes errors \
        < "$cache"

    model=$(disk_model "/dev/$disk")
    serial=$(disk_serial "/dev/$disk")

    log_msg \
        "BAY$bay $ata disk=$disk SMART=BAD model=\"$model\" serial=\"$serial\" health=\"$health\" attributes=$attributes errorlog=$errors"
}

# ----------------------------------------------------------------------
# Log RAID state changes.
# ----------------------------------------------------------------------

log_raid_state()
{
    bay="$1"
    ata="$2"
    disk="$3"
    raid="$4"

    model=$(disk_model "/dev/$disk")
    serial=$(disk_serial "/dev/$disk")

    log_msg \
        "BAY$bay $ata disk=$disk model=\"$model\" serial=\"$serial\" RAID=$raid"
}

# ----------------------------------------------------------------------
# Apply LED state.
# ----------------------------------------------------------------------

apply_led()
{
    bay="$1"
    state="$2"

    case "$state" in
        off)
            "$H340LED" "hdd$bay" off
            ;;

        blue)
            "$H340LED" "hdd$bay" blue
            ;;

        purple)
            "$H340LED" "hdd$bay" purple
            ;;

        red)
            "$H340LED" "hdd$bay" red
            ;;

        "blink-purple "*)
            period=${state#blink-purple }

            "$H340LED" \
                "hdd$bay" \
                blink-purple \
                "$period"
            ;;

        "blink-purple-red "*)
            period=${state#blink-purple-red }

            "$H340LED" \
                "hdd$bay" \
                blink-purple-red \
                "$period"
            ;;

        "blink-blue-red "*)
            period=${state#blink-blue-red }

            "$H340LED" \
                "hdd$bay" \
                blink-blue-red \
                "$period"
            ;;

        *)
            log_error \
                "BAY$bay: invalid LED state \"$state\""

            return 1
            ;;
    esac
}

# ----------------------------------------------------------------------
# Apply one bay state only when it changes.
# ----------------------------------------------------------------------

apply_bay()
{
    bay="$1"
    ata="$2"
    state="$3"
    raid="$4"
    disk="$5"

    state_file="$RUNTIME_DIR/bay$bay.state"
    disk_file="$RUNTIME_DIR/bay$bay.disk"
    raid_file="$RUNTIME_DIR/bay$bay.raid"

    old_state=""
    old_disk=""
    old_raid=""

    if [ -f "$state_file" ]; then
        old_state=$(cat "$state_file" 2>/dev/null)
    fi

    if [ -f "$disk_file" ]; then
        old_disk=$(cat "$disk_file" 2>/dev/null)
    fi

    if [ -f "$raid_file" ]; then
        old_raid=$(cat "$raid_file" 2>/dev/null)
    fi

    # --------------------------------------------------------------
    # Physical disk insertion/removal.
    # --------------------------------------------------------------

    if [ "$disk" != "$old_disk" ]; then

        if [ -n "$disk" ]; then
            model=$(disk_model "/dev/$disk")
            serial=$(disk_serial "/dev/$disk")

            log_msg \
                "BAY$bay $ata: disk present disk=$disk model=\"$model\" serial=\"$serial\""

            rm -f "$RUNTIME_DIR/smart$bay"
        else
            if [ -n "$old_disk" ]; then
                log_msg \
                    "BAY$bay $ata: disk removed disk=$old_disk"
            fi

            rm -f "$RUNTIME_DIR/smart$bay"
        fi

        if [ -n "$disk" ]; then
            printf '%s\n' "$disk" > "$disk_file"
        else
            rm -f "$disk_file"
        fi
    fi

    # --------------------------------------------------------------
    # RAID state change.
    # --------------------------------------------------------------

    if [ "$raid" != "$old_raid" ]; then

        if [ -n "$disk" ]; then
            log_raid_state \
                "$bay" \
                "$ata" \
                "$disk" \
                "$raid"
        fi

        if [ -n "$disk" ]; then
            printf '%s\n' "$raid" > "$raid_file"
        else
            rm -f "$raid_file"
        fi
    fi

    # --------------------------------------------------------------
    # Nothing changed.
    # --------------------------------------------------------------

    if [ "$old_state" = "$state" ]; then
        return
    fi

    # --------------------------------------------------------------
    # Apply LED.
    # --------------------------------------------------------------

    if ! apply_led "$bay" "$state"; then
        return 1
    fi

    printf '%s\n' "$state" > "$state_file"

    log_msg \
        "BAY$bay $ata: LED \"$old_state\" -> \"$state\""

    case "$state" in
        "blink-purple-red "*)
            if [ -n "$disk" ]; then
                log_smart_problem \
                    "$bay" \
                    "$ata" \
                    "$disk"
            fi
            ;;

        "blink-blue-red "*)
            if [ -n "$disk" ]; then
                log_smart_problem \
                    "$bay" \
                    "$ata" \
                    "$disk"
            fi
            ;;
    esac
}

# ----------------------------------------------------------------------
# Update one bay.
# ----------------------------------------------------------------------

update_bay()
{
    bay="$1"
    ata="$2"

    disk=$(find_disk_for_ata "$ata")

    if [ -z "$disk" ]; then
        raid="NONE"
        state="off"
    else
        raid=$(raid_state_for_disk "$disk")
        state=$(desired_led "$bay" "$ata")
    fi

    apply_bay \
        "$bay" \
        "$ata" \
        "$state" \
        "$raid" \
        "$disk"
}

# ----------------------------------------------------------------------
# Signal handling.
# ----------------------------------------------------------------------

stop_monitor()
{
    RUNNING=0
}

# ----------------------------------------------------------------------
# Cleanup.
# ----------------------------------------------------------------------

cleanup()
{
    log_msg "stopping"

    "$H340LED" all off >/dev/null 2>&1

    rm -rf "$RUNTIME_DIR/lock"
}

# ----------------------------------------------------------------------
# Startup.
# ----------------------------------------------------------------------

trap stop_monitor TERM INT
trap cleanup EXIT

mkdir -p "$RUNTIME_DIR"
mkdir -p "$CONFIG_DIR"

# Prevent multiple monitor instances.
if ! mkdir "$RUNTIME_DIR/lock" 2>/dev/null; then
    log_error "h340raidmon is already running"
    exit 1
fi

log_msg "starting"

# Remember any currently active array UUIDs.
remember_array_uuids

# Ensure h340led daemon is running.
if ! pidof h340led >/dev/null 2>&1; then
    log_msg "starting h340led daemon"

    "$H340LED" daemon >/dev/null 2>&1 &

    sleep 1
fi

# Start from a known hardware state.
"$H340LED" all off

rm -f \
    "$RUNTIME_DIR/bay1.state" \
    "$RUNTIME_DIR/bay2.state" \
    "$RUNTIME_DIR/bay3.state" \
    "$RUNTIME_DIR/bay4.state" \
    "$RUNTIME_DIR/bay1.disk" \
    "$RUNTIME_DIR/bay2.disk" \
    "$RUNTIME_DIR/bay3.disk" \
    "$RUNTIME_DIR/bay4.disk" \
    "$RUNTIME_DIR/bay1.raid" \
    "$RUNTIME_DIR/bay2.raid" \
    "$RUNTIME_DIR/bay3.raid" \
    "$RUNTIME_DIR/bay4.raid" \
    "$RUNTIME_DIR/smart1" \
    "$RUNTIME_DIR/smart2" \
    "$RUNTIME_DIR/smart3" \
    "$RUNTIME_DIR/smart4"

# ----------------------------------------------------------------------
# Main loop.
# ----------------------------------------------------------------------

while [ "$RUNNING" -eq 1 ]; do

    remember_array_uuids

    update_bay 1 ata1
    update_bay 2 ata2
    update_bay 3 ata3
    update_bay 4 ata4

    sleep "$POLL_INTERVAL"
done

exit 0
