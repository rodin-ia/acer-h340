#!/bin/sh

# h340raidmon
# Acer Aspire easyStore H340 RAID / SMART LED monitor
#
# Physical bay mapping:
#
#   bay1 -> ata1    bay2 -> ata2    bay3 -> ata3    bay4 -> ata4
#
# LED states (first match wins):
#
#   1. No disk                                   OFF
#   2. Disk faulty in md, or removed from RAID   RED solid
#      (still carries a known RAID superblock)
#   3. Disk participating in resync/recover/     PURPLE <-> OFF, 1.0s
#      reshape
#   4. Disk in RAID + SMART problem              PURPLE <-> RED, 1.0s
#   5. Disk in RAID + SMART OK                   PURPLE solid
#   6. Disk not in RAID + SMART problem          BLUE <-> RED, 1.0s
#   7. Disk not in RAID + SMART OK               BLUE solid
#
# md sync_action:
#
#   resync / reshape   every non-faulty member is shown as rebuilding
#   recover            only members that are not in_sync (the target)
#   check / repair     NOT treated as rebuild
#
# SMART problem means:
#
#   - overall health is not PASSED/OK
#   - an attribute has WHEN_FAILED set
#   - ATA error log is non-empty (optionally: only errors younger than
#     ERROR_MAX_AGE_HOURS power-on hours)
#
# SMART is queried with "-n standby": a sleeping disk is never woken up,
# its previous status is kept. If smartctl gives no usable answer the
# previous status is kept as well (no false red blinking).
#
# Overrides can be placed in /etc/default/h340raidmon (plain sh).
#
# Logging:   logger -t h340raidmon
# Runtime:   /var/run/h340raidmon/   (informational, per-bay files)
# Known md UUIDs (append-only): /etc/h340raidmon/array-uuids

PATH=/usr/sbin:/usr/bin:/sbin:/bin

H340LED=/usr/bin/h340led
SMARTCTL=/usr/sbin/smartctl
MDADM=/usr/sbin/mdadm

BLOCK_BASE=/sys/class/block
MD_BASE=/sys/block

RUNTIME_DIR=/var/run/h340raidmon
LOCK_DIR=$RUNTIME_DIR/lock
CONFIG_DIR=/etc/h340raidmon
ARRAY_UUID_FILE=$CONFIG_DIR/array-uuids

POLL_INTERVAL=1            # main loop period, seconds
SMART_CACHE_AGE=30         # how often SMART is re-read per bay
EXAMINE_CACHE_AGE=60       # how often non-member disks are checked for old md superblocks
UUID_REFRESH_AGE=60        # how often active md UUIDs are collected
DAEMON_CHECK_AGE=10        # how often the h340led daemon is checked
ERROR_LOG_INTERVAL=60      # rate limit for repeated error messages

SMART_TIMEOUT=10           # seconds; timeout is mandatory
MDADM_TIMEOUT=10
SMART_OPTS=""              # e.g. "-d sat"
ERROR_MAX_AGE_HOURS=0      # 0 = any ATA error counts forever

REBUILD_PERIOD=1.0
SMART_BLINK_PERIOD=1.0

[ -r /etc/default/h340raidmon ] && . /etc/default/h340raidmon

RUNNING=1
NOW=0

# ----------------------------------------------------------------------
# Small helpers (no forks)
# ----------------------------------------------------------------------

log_msg()
{
    logger -t h340raidmon "$*"
}

log_error()
{
    logger -t h340raidmon -p daemon.err "$*"
}

# getvar NAME OUTVAR  /  setvar NAME VALUE   (indirect variables)
getvar()
{
    eval "$2=\${$1:-}"
}

setvar()
{
    eval "$1=\$2"
}

# Rate-limited error log: log_error_rl KEY MESSAGE...
log_error_rl()
{
    local last key
    key=$1
    shift

    getvar "LASTLOG_$key" last
    case "$last" in
        ''|*[!0-9]*) last=0 ;;
    esac

    [ $((NOW - last)) -ge "$ERROR_LOG_INTERVAL" ] || return 0

    setvar "LASTLOG_$key" "$NOW"
    log_error "$*"
}

# Split "a|b|c|d|e" into F1..F5 (F5 keeps the remainder).
split5()
{
    _rest=$1

    F1=${_rest%%|*}
    case "$_rest" in *'|'*) _rest=${_rest#*|} ;; *) _rest= ;; esac
    F2=${_rest%%|*}
    case "$_rest" in *'|'*) _rest=${_rest#*|} ;; *) _rest= ;; esac
    F3=${_rest%%|*}
    case "$_rest" in *'|'*) _rest=${_rest#*|} ;; *) _rest= ;; esac
    F4=${_rest%%|*}
    case "$_rest" in *'|'*) _rest=${_rest#*|} ;; *) _rest= ;; esac
    F5=$_rest
}

if command -v timeout >/dev/null 2>&1; then
    TIMEOUT=timeout
else
    TIMEOUT=""
fi

# run_to SECONDS COMMAND...
run_to()
{
    local secs
    secs=$1
    shift

    # Never run potentially blocking disk utilities without a timeout.
    [ -n "$TIMEOUT" ] || return 127
    "$TIMEOUT" "$secs" "$@"
}

# ----------------------------------------------------------------------
# Physical bay -> /dev/sdX
#
# Fast path: sysfs ata_port glob, no forks.
# Fallback:  readlink on /sys/class/block/sd?
# ----------------------------------------------------------------------

DISK_METHOD=readlink

detect_disk_method()
{
    local n p

    DISK_METHOD=readlink
    [ -d /sys/class/ata_port ] || return 0

    for n in 1 2 3 4 5 6 7 8; do
        for p in /sys/class/ata_port/ata$n/device/host*/target*/*/block/sd*; do
            if [ -e "$p" ]; then
                DISK_METHOD=glob
                return 0
            fi
        done
    done
}

# Sets DISK (empty when the bay has no disk).
find_disk_for_ata()
{
    local ata p d path

    ata=$1
    DISK=""

    if [ "$DISK_METHOD" = glob ]; then
        for p in /sys/class/ata_port/$ata/device/host*/target*/*/block/sd*; do
            [ -e "$p" ] || continue
            DISK=${p##*/}
            return 0
        done
        return 1
    fi

    for d in "$BLOCK_BASE"/sd?; do
        [ -e "$d" ] || continue
        path=$(readlink "$d" 2>/dev/null)

        case "$path" in
            *"/$ata/"*)
                DISK=${d##*/}
                return 0
                ;;
        esac
    done

    return 1
}

# Model / serial for logging. Sets INFO_MODEL, INFO_SERIAL.
disk_info()
{
    local out

    # -n standby prevents an informational query from waking a sleeping HDD.
    out=$(
        run_to "$SMART_TIMEOUT" "$SMARTCTL" -n standby -i $SMART_OPTS "$1" 2>/dev/null |
            awk -F: '
                /^(Device Model|Model Number|Product):/ {
                    gsub(/^[ \t]+/, "", $2); m = $2
                }
                /^Serial [Nn]umber:/ {
                    gsub(/^[ \t]+/, "", $2); s = $2
                }
                END { printf "%s|%s\n", m, s }
            '
    )

    split5 "$out"
    INFO_MODEL=$F1
    INFO_SERIAL=$F2
}

# Build a disk key from kernel-provided identifiers. WWID is preferred;
# SATA sysfs serial is the fallback. Model is deliberately not an identity.
disk_identity()
{
    local disk ident

    disk=$1
    ident=""

    if [ -r "$BLOCK_BASE/$disk/device/wwid" ]; then
        read -r ident < "$BLOCK_BASE/$disk/device/wwid" || ident=""
    fi

    if [ -z "$ident" ] && [ -r "$BLOCK_BASE/$disk/device/serial" ]; then
        read -r ident < "$BLOCK_BASE/$disk/device/serial" || ident=""
        [ -n "$ident" ] && ident="serial:$ident"
    fi

    if [ -z "$ident" ]; then
        # No stable hardware ID was exposed by sysfs. Keep the limitation
        # explicit; the bay/device name is only a best-effort fallback.
        ident="unidentified"
    fi

    DISK_IDENT=$ident
}

# ----------------------------------------------------------------------
# SMART
#
# One smartctl call: -H -A -l error, never wakes a sleeping disk.
# awk output:
#
#   STANDBY
#   UNKNOWN
#   health|attrs(OK/BAD)|ata_error_count|age_of_last_error_in_hours
# ----------------------------------------------------------------------

AWK_SMART='
BEGIN {
    health = ""; attrs = "OK"; cnt = ""; poh = ""; lasterr = ""
    wf = 0; health_seen = 0; attr_seen = 0; error_seen = 0
    standby = 0; inattr = 0
}

/Device is in (STANDBY|SLEEP)/ { standby = 1 }

/SMART overall-health self-assessment test result:/ {
    sub(/^.*result:[ \t]*/, ""); health = $0; health_seen = 1
}

/SMART Health Status:/ {
    sub(/^.*Status:[ \t]*/, ""); health = $0; health_seen = 1
}

/^ID#?[ \t]+ATTRIBUTE_NAME/ {
    wf = 0
    for (i = 1; i <= NF; i++)
        if ($i == "WHEN_FAILED") wf = i
    inattr = 1; attr_seen = 1
    next
}

inattr && /^[ \t]*$/ { inattr = 0; next }

inattr && /^[ \t]*[0-9]+[ \t]/ {
    if (wf > 0 && NF >= wf && $wf != "-") attrs = "BAD"
    # RAW_VALUE is the final field in  smartctl ATA attribute table.
    # WHEN_FAILED is not followed by Power_On_Hours; the old parser
    # incorrectly tried to read the field after WHEN_FAILED.
    if ($1 == 9 && NF > 1) poh = $NF + 0
    next
}

/^ATA Error Count:/ { cnt = $4 + 0; error_seen = 1 }
/No Errors Logged/  { cnt = 0; error_seen = 1 }

lasterr == "" && /^Error [0-9]+.*occurred at disk power-on lifetime:/ {
    if (match($0, /lifetime: [0-9]+/))
        lasterr = substr($0, RSTART + 10, RLENGTH - 10) + 0
}

END {
    if (standby) { print "STANDBY"; exit }
    # A table header alone is not proof that SMART health is readable.
    # Still pass through concrete attribute / ATA-error findings if present.
    if (!health_seen && attrs != "BAD" && (cnt == "" || cnt == 0)) {
        print "UNKNOWN"
        exit
    }
    age = ""
    if (lasterr != "" && poh != "" && poh >= lasterr)
        age = poh - lasterr
    printf "%s|%s|%s|%s\n", health, attrs, cnt, age
}
'

# Cache variable SMART_<bay>:  timestamp|key|status|probe|detail
#   status: OK | UNKNOWN | BAD_HEALTH | BAD_ATTRIBUTES | BAD_ERRORLOG[:...]
#   probe : OK | STANDBY | UNKNOWN  (what the last probe returned)
# Sets SMART_STATUS.
refresh_smart()
{
    local bay disk key out o_status o_probe o_detail
    local status probe detail health attrs cnt age

    bay=$1
    disk=$2
    key=$3

    # No previous result means UNKNOWN, never assume a new disk is healthy.
    o_status=UNKNOWN
    o_probe=""
    o_detail=""

    getvar "SMART_$bay" out
    if [ -n "$out" ]; then
        split5 "$out"
        if [ "$F2" = "$key" ]; then
            o_status=$F3
            o_probe=$F4
            o_detail=$F5
        fi
    fi

    out=$(
        run_to "$SMART_TIMEOUT" "$SMARTCTL" -n standby -H -A -l error \
            $SMART_OPTS "/dev/$disk" 2>/dev/null |
            awk "$AWK_SMART"
    )

    NOW=$(date +%s)

    case "$out" in
        STANDBY)
            status=$o_status
            probe=STANDBY
            detail=${o_detail:-"SMART unavailable while disk is in standby"}
            ;;

        UNKNOWN|"")
            status=$o_status
            probe=UNKNOWN
            detail=${o_detail:-"no usable SMART health data"}

            if [ "$o_probe" != UNKNOWN ]; then
                log_error_rl "smart_unknown_$bay" "BAY$bay disk=$disk: no usable SMART data; status remains ${status}"
            fi
            ;;

        *)
            split5 "$out"
            health=$F1
            attrs=$F2
            cnt=$F3
            age=$F4

            status=OK
            probe=OK
            detail="health=${health:-n/a} attributes=$attrs ata_errors=${cnt:-n/a}"

            case "$health" in
                ""|PASSED|OK) ;;
                *) status=BAD_HEALTH ;;
            esac

            if [ "$status" = OK ] && [ "$attrs" = BAD ]; then
                status=BAD_ATTRIBUTES
            fi

            if [ "$status" = OK ] && [ "${cnt:-0}" -gt 0 ] 2>/dev/null; then
                if [ "$ERROR_MAX_AGE_HOURS" -le 0 ]; then
                    status="BAD_ERRORLOG:$cnt"
                elif [ -z "$age" ]; then
                    # Unknown/invalid age is treated conservatively: an ATA
                    # error is not silently ignored just because its age
                    # could not be established.
                    status="BAD_ERRORLOG_AGE_UNKNOWN:$cnt"
                elif [ "$age" -le "$ERROR_MAX_AGE_HOURS" ]; then
                    status="BAD_ERRORLOG:$cnt"
                fi
            fi
            ;;
    esac

    setvar "SMART_$bay" "$NOW|$key|$status|$probe|$detail"
    printf '%s|%s|%s|%s|%s\n' "$NOW" "$key" "$status" "$probe" "$detail" \
        > "$RUNTIME_DIR/smart$bay" 2>/dev/null

    SMART_STATUS=$status
}

# Sets SMART_STATUS, uses the cache when fresh and for the same disk.
get_smart_status()
{
    local bay disk key c ts age

    bay=$1
    disk=$2
    key=$3

    getvar "SMART_$bay" c

    if [ -n "$c" ]; then
        split5 "$c"

        ts=$F1
        case "$ts" in
            ''|*[!0-9]*) ts=0 ;;
        esac

        age=$((NOW - ts))

        if [ "$F2" = "$key" ] &&
           [ "$age" -ge 0 ] &&
           [ "$age" -lt "$SMART_CACHE_AGE" ]; then
            SMART_STATUS=$F3
            return 0
        fi
    fi

    refresh_smart "$bay" "$disk" "$key"
}

# ----------------------------------------------------------------------
# md arrays
# ----------------------------------------------------------------------

known_array_uuid()
{
    [ -n "$1" ] || return 1
    [ -f "$ARRAY_UUID_FILE" ] || return 1

    grep -Fxq "$1" "$ARRAY_UUID_FILE"
}

# Append UUIDs of active arrays. The file is never rewritten, and is
# only touched when a new UUID appears.
remember_array_uuids()
{
    local md name uuid

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue
        name=${md##*/}

        uuid=$(
            run_to "$MDADM_TIMEOUT" "$MDADM" --detail --export "/dev/$name" \
                2>/dev/null |
                sed -n 's/^MD_UUID=//p' |
                head -n 1
        )

        [ -n "$uuid" ] || continue

        if ! known_array_uuid "$uuid"; then
            printf '%s\n' "$uuid" >> "$ARRAY_UUID_FILE"
            log_msg "remembered array $name uuid=$uuid"
        fi
    done
}

# Does the disk or one of its partitions carry a known md superblock?
disk_has_known_array()
{
    local dev uuid

    [ -s "$ARRAY_UUID_FILE" ] || return 1

    for dev in "/dev/$1" "/dev/$1"[0-9]*; do
        [ -b "$dev" ] || continue

        uuid=$(
            run_to "$MDADM_TIMEOUT" "$MDADM" --examine --export "$dev" \
                2>/dev/null |
                sed -n 's/^MD_UUID=//p' |
                head -n 1
        )

        if known_array_uuid "$uuid"; then
            return 0
        fi
    done

    return 1
}

# Cached variant, cache variable EXAMINE_<bay>: timestamp|key|0/1
disk_has_known_array_cached()
{
    local bay disk key c ts age res

    bay=$1
    disk=$2
    key=$3

    getvar "EXAMINE_$bay" c

    if [ -n "$c" ]; then
        split5 "$c"

        ts=$F1
        case "$ts" in
            ''|*[!0-9]*) ts=0 ;;
        esac

        age=$((NOW - ts))

        if [ "$F2" = "$key" ] &&
           [ "$age" -ge 0 ] &&
           [ "$age" -lt "$EXAMINE_CACHE_AGE" ]; then
            [ "$F3" = 1 ]
            return
        fi
    fi

    if disk_has_known_array "$disk"; then
        res=1
    else
        res=0
    fi

    setvar "EXAMINE_$bay" "$NOW|$key|$res"

    [ "$res" = 1 ]
}

# Raise the per-disk md state: MEMBER < REBUILD < FAULTY.
merge_md_state()
{
    local disk new cur

    disk=$1
    new=$2

    getvar "MDSTATE_$disk" cur

    if [ -z "$cur" ]; then
        MD_DISKS="$MD_DISKS $disk"
    fi

    case "$cur:$new" in
        FAULTY:*)  ;;
        *:FAULTY)  setvar "MDSTATE_$disk" FAULTY ;;
        REBUILD:*) ;;
        *:REBUILD) setvar "MDSTATE_$disk" REBUILD ;;
        *)         setvar "MDSTATE_$disk" MEMBER ;;
    esac
}

# One pass over /sys/block/md*/md/dev-*; afterwards MDSTATE_<disk> holds
# FAULTY / REBUILD / MEMBER for every disk that is part of any array.
# Pure shell builtins, no forks.
MD_DISKS=""

snapshot_md()
{
    local d md name action sd dn st disk level

    for d in $MD_DISKS; do
        eval "unset MDSTATE_$d"
    done
    MD_DISKS=""

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue
        name=${md##*/}

        action=""
        if [ -r "$md/md/sync_action" ]; then
            read -r action < "$md/md/sync_action" || action=""
        fi

        for sd in "$md"/md/dev-*; do
            [ -r "$sd/state" ] || continue

            dn=${sd##*/dev-}
            disk=${dn%%[0-9]*}

            case "$disk" in
                ""|*[!a-zA-Z0-9]*) continue ;;
            esac

            st=""
            read -r st < "$sd/state" || st=""

            level=MEMBER

            case "$st" in
                *faulty*|*write_error*)
                    level=FAULTY
                    ;;
                *)
                    case "$action" in
                        resync|reshape)
                            level=REBUILD
                            ;;
                        recover)
                            case ",$st," in
                                *,in_sync,*) ;;
                                *) level=REBUILD ;;
                            esac
                            ;;
                    esac
                    ;;
            esac

            merge_md_state "$disk" "$level"
        done
    done
}

# Sets RAID: FAULTY | REBUILD | MEMBER | DROPPED | NONE
raid_state_for_disk()
{
    getvar "MDSTATE_$2" RAID

    [ -n "$RAID" ] && return 0

    if disk_has_known_array_cached "$1" "$2" "$3"; then
        RAID=DROPPED
    else
        RAID=NONE
    fi
}

# ----------------------------------------------------------------------
# LED decision. Input: bay disk key, RAID. Sets STATE.
# ----------------------------------------------------------------------

decide_led()
{
    case "$RAID" in
        FAULTY|DROPPED)
            STATE=red
            return 0
            ;;
        REBUILD)
            STATE="blink-purple $REBUILD_PERIOD"
            return 0
            ;;
    esac

    get_smart_status "$1" "$2" "$3"

    case "$RAID:$SMART_STATUS" in
        MEMBER:OK)      STATE=purple ;;
        MEMBER:UNKNOWN) STATE=purple ;; # neutral fallback; see runtime/smartN
        MEMBER:*)       STATE="blink-purple-red $SMART_BLINK_PERIOD" ;;
        *:OK)           STATE=blue ;;
        *:UNKNOWN)      STATE=blue ;;   # neutral fallback; not a SMART-OK claim
        *)              STATE="blink-blue-red $SMART_BLINK_PERIOD" ;;
    esac
}

apply_led()
{
    local bay state

    bay=$1
    state=$2

    case "$state" in
        off|blue|purple|red)
            "$H340LED" "hdd$bay" "$state"
            ;;

        "blink-purple "*|"blink-purple-red "*|"blink-blue-red "*)
            set -- $state
            "$H340LED" "hdd$bay" "$1" "$2"
            ;;

        *)
            log_error "BAY$bay: invalid LED state \"$state\""
            return 1
            ;;
    esac
}

log_smart_problem()
{
    local bay ata disk c

    bay=$1
    ata=$2
    disk=$3

    getvar "SMART_$bay" c
    [ -n "$c" ] || return 0
    split5 "$c"

    disk_info "/dev/$disk"

    log_msg "BAY$bay $ata disk=$disk SMART=BAD status=$F3 model=\"$INFO_MODEL\" serial=\"$INFO_SERIAL\" $F5"
}

# ----------------------------------------------------------------------
# Apply one bay; the LED command runs only when something changed.
# ----------------------------------------------------------------------

apply_bay()
{
    local bay ata disk key raid state
    local old_key old_raid old_state info_loaded

    bay=$1
    ata=$2
    disk=$3
    key=$4
    raid=$5
    state=$6

    getvar "DISKKEY_$bay" old_key
    getvar "RAID_$bay" old_raid
    getvar "LED_$bay" old_state
    info_loaded=0

    # Disk inserted / removed / replaced.
    if [ "$key" != "$old_key" ]; then
        if [ -n "$disk" ]; then
            disk_info "/dev/$disk"
            info_loaded=1
            log_msg "BAY$bay $ata: disk present disk=$disk model=\"$INFO_MODEL\" serial=\"$INFO_SERIAL\""
            printf '%s\n' "$disk" > "$RUNTIME_DIR/bay$bay.disk"
        else
            log_msg "BAY$bay $ata: disk removed disk=${old_key%%:*}"
            rm -f "$RUNTIME_DIR/bay$bay.disk" "$RUNTIME_DIR/smart$bay"
            eval "unset SMART_$bay EXAMINE_$bay"
        fi

        setvar "DISKKEY_$bay" "$key"
    fi

    # RAID state change.
    if [ "$raid" != "$old_raid" ]; then
        if [ -n "$disk" ]; then
            [ "$info_loaded" -eq 1 ] || disk_info "/dev/$disk"
            log_msg "BAY$bay $ata disk=$disk model=\"$INFO_MODEL\" serial=\"$INFO_SERIAL\" RAID=$raid"
            printf '%s\n' "$raid" > "$RUNTIME_DIR/bay$bay.raid"
        else
            rm -f "$RUNTIME_DIR/bay$bay.raid"
        fi

        setvar "RAID_$bay" "$raid"
    fi

    [ "$state" = "$old_state" ] && return 0

    if ! apply_led "$bay" "$state"; then
        log_error_rl "led$bay" "BAY$bay: h340led failed for \"$state\", will retry"
        return 1
    fi

    setvar "LED_$bay" "$state"
    printf '%s\n' "$state" > "$RUNTIME_DIR/bay$bay.state"

    log_msg "BAY$bay $ata: LED \"$old_state\" -> \"$state\""

    case "$state" in
        "blink-purple-red "*|"blink-blue-red "*)
            [ -n "$disk" ] && log_smart_problem "$bay" "$ata" "$disk"
            ;;
    esac

    return 0
}

update_bay()
{
    local bay ata disk key ident

    bay=$1
    ata=$2

    find_disk_for_ata "$ata"
    disk=$DISK

    if [ -z "$disk" ]; then
        apply_bay "$bay" "$ata" "" "" "" off
        return
    fi

    # WWID is preferred; sysfs serial is the fallback. If neither exists,
    # the key is explicitly marked unidentified (see disk_identity comments).
    disk_identity "$disk"
    key="$disk:$DISK_IDENT"

    raid_state_for_disk "$bay" "$disk" "$key"
    decide_led "$bay" "$disk" "$key"

    apply_bay "$bay" "$ata" "$disk" "$key" "$RAID" "$STATE"
}

# ----------------------------------------------------------------------
# h340led daemon
# ----------------------------------------------------------------------

reset_led_state()
{
    local b

    for b in 1 2 3 4; do
        setvar "LED_$b" ""
    done
}

ensure_daemon()
{
    pidof h340led >/dev/null 2>&1 && return 0

    log_msg "h340led daemon not running, starting it"

    "$H340LED" daemon >/dev/null 2>&1 &
    sleep 1

    if ! pidof h340led >/dev/null 2>&1; then
        log_error_rl daemon_start "h340led daemon failed to start"
        return 1
    fi

    # A fresh daemon knows nothing: force every LED to be applied again.
    reset_led_state
}

# ----------------------------------------------------------------------
# Lock, signals, cleanup
# ----------------------------------------------------------------------

acquire_lock()
{
    local pid

    if mkdir "$LOCK_DIR" 2>/dev/null; then
        echo $$ > "$LOCK_DIR/pid"
        return 0
    fi

    pid=""
    [ -r "$LOCK_DIR/pid" ] && read -r pid < "$LOCK_DIR/pid"

    # The other instance may have just created the directory.
    if [ -z "$pid" ]; then
        sleep 1
        [ -r "$LOCK_DIR/pid" ] && read -r pid < "$LOCK_DIR/pid"
    fi

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        # PID reuse must not make an unrelated process look like our daemon.
        if [ -r "/proc/$pid/cmdline" ] &&
           tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq 'h340raidmon'; then
            return 1
        fi
    fi

    log_msg "removing stale lock (pid ${pid:-unknown})"
    rm -rf "$LOCK_DIR"

    mkdir "$LOCK_DIR" 2>/dev/null || return 1
    echo $$ > "$LOCK_DIR/pid"
}

stop_monitor()
{
    RUNNING=0
}

cleanup()
{
    local lock_pid

    log_msg "stopping"

    if ! "$H340LED" all off >/dev/null 2>&1; then
        log_error "failed to switch all LEDs off during cleanup"
    fi

    lock_pid=""
    [ -r "$LOCK_DIR/pid" ] && read -r lock_pid < "$LOCK_DIR/pid"
    if [ "$lock_pid" = "$$" ]; then
        rm -rf "$LOCK_DIR"
    fi
}

# ----------------------------------------------------------------------
# Configuration validation
# ----------------------------------------------------------------------

is_uint()
{
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_config()
{
    local name value

    for name in POLL_INTERVAL SMART_CACHE_AGE EXAMINE_CACHE_AGE \
                UUID_REFRESH_AGE DAEMON_CHECK_AGE ERROR_LOG_INTERVAL \
                SMART_TIMEOUT MDADM_TIMEOUT ERROR_MAX_AGE_HOURS; do
        eval "value=\${$name}"
        if ! is_uint "$value"; then
            log_error "invalid configuration: $name must be a non-negative integer (got '$value')"
            return 1
        fi
    done

    [ "$POLL_INTERVAL" -ge 1 ] && [ "$ERROR_LOG_INTERVAL" -ge 1 ] || {
        log_error "invalid configuration: POLL_INTERVAL and ERROR_LOG_INTERVAL must be at least 1"
        return 1
    }
    [ "$SMART_TIMEOUT" -ge 1 ] && [ "$MDADM_TIMEOUT" -ge 1 ] || {
        log_error "invalid configuration: command timeouts must be at least 1 second"
        return 1
    }
    [ "$SMART_CACHE_AGE" -ge 1 ] && [ "$EXAMINE_CACHE_AGE" -ge 1 ] && \
    [ "$UUID_REFRESH_AGE" -ge 1 ] && [ "$DAEMON_CHECK_AGE" -ge 1 ] || {
        log_error "invalid configuration: cache/check intervals must be at least 1 second"
        return 1
    }

    for value in "$REBUILD_PERIOD" "$SMART_BLINK_PERIOD"; do
        case "$value" in
            ''|*[!0-9.]*|.*|*.)
                log_error "invalid configuration: blink periods must be positive numbers"
                return 1
                ;;
            *.*.*)
                log_error "invalid configuration: blink periods must contain at most one decimal point"
                return 1
                ;;
        esac
        case "$value" in
            *[1-9]*) ;;
            *)
                log_error "invalid configuration: blink periods must be greater than zero"
                return 1
                ;;
        esac
    done

    return 0
}

# ----------------------------------------------------------------------
# Startup
# ----------------------------------------------------------------------

mkdir -p "$RUNTIME_DIR" "$CONFIG_DIR"

for tool in "$H340LED" "$SMARTCTL" "$MDADM"; do
    if [ ! -x "$tool" ]; then
        log_error "required tool not found: $tool"
        exit 1
    fi
done

if [ -z "$TIMEOUT" ]; then
    log_error "required command not found: timeout (unbounded disk commands are disabled)"
    exit 1
fi

if ! validate_config; then
    exit 1
fi

# The lock comes first; the EXIT trap is installed only after it is held,
# so a second instance can never switch off the LEDs of the first one.
if ! acquire_lock; then
    log_error "h340raidmon is already running"
    exit 1
fi

trap cleanup EXIT
trap stop_monitor TERM INT HUP

log_msg "starting"

detect_disk_method
log_msg "disk lookup method: $DISK_METHOD"

NOW=$(date +%s)
remember_array_uuids

ensure_daemon

# Start from a known hardware state. If this fails, keep cached LED states
# empty so each bay update retries its individual LED command.
if ! "$H340LED" all off; then
    log_error "h340led all off failed during startup; individual LEDs will be retried"
fi
reset_led_state

rm -f "$RUNTIME_DIR"/bay*.state "$RUNTIME_DIR"/bay*.disk \
      "$RUNTIME_DIR"/bay*.raid "$RUNTIME_DIR"/smart*

# ----------------------------------------------------------------------
# Main loop
# ----------------------------------------------------------------------

last_uuid=$NOW
last_daemon=$NOW

while [ "$RUNNING" -eq 1 ]; do

    NOW=$(date +%s)

    if [ $((NOW - last_daemon)) -ge "$DAEMON_CHECK_AGE" ]; then
        last_daemon=$NOW
        ensure_daemon
    fi

    if [ $((NOW - last_uuid)) -ge "$UUID_REFRESH_AGE" ]; then
        last_uuid=$NOW
        remember_array_uuids
    fi

    snapshot_md

    update_bay 1 ata1
    update_bay 2 ata2
    update_bay 3 ata3
    update_bay 4 ata4

    # "sleep & wait" lets TERM/INT interrupt the pause immediately.
    sleep "$POLL_INTERVAL" &
    wait $!
done

exit 0
