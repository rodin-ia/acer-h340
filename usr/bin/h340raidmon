#!/bin/sh

# h340raidmon
# Acer Aspire easyStore H340 RAID / SMART LED monitor
#
# Physical bay mapping:
#   bay1 -> ata1
#   bay2 -> ata2
#   bay3 -> ata3
#   bay4 -> ata4
#
# LED states:
#
#   no disk
#       OFF
#
#   RAID recovery/rebuild
#       PURPLE BLINK 1.0s
#
#   RAID member faulty/blocked/write_error
#       RED SOLID
#
#   RAID member + SMART problem
#       RED BLINK 1.0s
#
#   RAID member + SMART OK
#       BLUE SOLID
#
# SMART problem means:
#
#   - SMART overall-health is not PASSED/OK
#   - an attribute has a non-empty WHEN_FAILED field
#   - SMART error log contains ATA errors
#
# This monitor controls h340led through its CLI/state interface.
# The h340led daemon performs the actual GPIO access.

PATH=/usr/sbin:/usr/bin:/sbin:/bin

H340LED=/usr/bin/h340led
SMARTCTL=/usr/sbin/smartctl

BLOCK_BASE=/sys/class/block
MD_BASE=/sys/block

RUNTIME_DIR=/var/run/h340raidmon

POLL_INTERVAL=1
SMART_INTERVAL=15

REBUILD_PERIOD=1.0
SMART_BLINK_PERIOD=1.0

RUNNING=1

# ----------------------------------------------------------------------
# Basic helpers
# ----------------------------------------------------------------------

log_msg()
{
    logger -t h340raidmon "$*"
}

sleep_1s()
{
    sleep "$POLL_INTERVAL"
}

# ----------------------------------------------------------------------
# Find the current /dev/sdX for a physical ATA port.
# ----------------------------------------------------------------------

find_disk_for_ata()
{
    ata="$1"

    for d in "$BLOCK_BASE"/sd?; do
        [ -e "$d/device" ] || continue

        path=$(readlink -f "$d/device")

        case "$path" in
            *"/$ata/"*)
                echo "${d##*/}"
                return 0
                ;;
        esac
    done

    return 1
}

# ----------------------------------------------------------------------
# SMART test
#
# One smartctl invocation is used for:
#   - information
#   - health
#   - attributes
#   - error log
#
# Result:
#   OK
#   BAD
# ----------------------------------------------------------------------

smart_status()
{
    dev="$1"

    output=$(
        "$SMARTCTL" -i -H -A -l error "$dev" 2>&1
    )

    health=$(
        printf '%s\n' "$output" |
        awk '
            /SMART overall-health self-assessment test result:/ {
                sub(/^.*result:[[:space:]]*/, "")
                print
                exit
            }

            /SMART Health Status:/ {
                sub(/^.*Status:[[:space:]]*/, "")
                print
                exit
            }
        '
    )

    case "$health" in
        PASSED|OK)
            ;;
        *)
            echo BAD
            return
            ;;
    esac

    # Detect SMART attributes with a non-empty WHEN_FAILED field.
    attr_bad=$(
        printf '%s\n' "$output" |
        awk '
            BEGIN {
                bad = 0
            }

            /^[[:space:]]*[0-9]+[[:space:]]/ {
                if ($0 ~ /FAILING_NOW/) {
                    bad = 1
                }

                # Standard smartctl ATA attribute table:
                #
                # ID NAME FLAG VALUE WORST THRESH TYPE UPDATED
                # WHEN_FAILED RAW_VALUE
                #
                # A non "-" WHEN_FAILED value means a recorded
                # attribute failure.
                if (NF >= 9 &&
                    $1 ~ /^[0-9]+$/ &&
                    $9 != "-") {
                    bad = 1
                }
            }

            END {
                print bad ? "BAD" : "OK"
            }
        '
    )

    if [ "$attr_bad" = "BAD" ]; then
        echo BAD
        return
    fi

    # Detect logged ATA errors.
    error_count=$(
        printf '%s\n' "$output" |
        awk '
            /ATA Error Count:/ {
                print $4
                exit
            }
        '
    )

    case "$error_count" in
        "")
            ;;
        0)
            ;;
        *)
            echo BAD
            return
            ;;
    esac

    # Some smartctl versions may omit ATA Error Count.
    # Check for an explicit "errors logged" indication as well.
    if printf '%s\n' "$output" |
        grep -qiE 'No Errors Logged|No Errors found'; then

        echo OK
        return
    fi

    # If an actual numbered error entry is present, classify as BAD.
    if printf '%s\n' "$output" |
        grep -qE '^[[:space:]]*[0-9]+[[:space:]]+.*[Ss]tatus:'; then

        echo BAD
        return
    fi

    echo OK
}

# ----------------------------------------------------------------------
# Get RAID state for one physical disk.
#
# Output:
#
#   NONE
#   MEMBER
#   FAULTY
#   REBUILD
#
# REBUILD has highest priority.
# ----------------------------------------------------------------------

raid_state_for_disk()
{
    disk="$1"

    found_member=0
    found_faulty=0

    for md in "$MD_BASE"/md*; do
        [ -d "$md/md" ] || continue

        action=$(cat "$md/md/sync_action" 2>/dev/null)

        for state_file in "$md"/md/dev-*/state; do
            [ -e "$state_file" ] || continue

            dev_dir=$(dirname "$state_file")
            dev_name=$(basename "$dev_dir")

            case "$dev_name" in
                dev-"$disk"|dev-"$disk"[0-9]*)
                    state=$(cat "$state_file" 2>/dev/null)

                    # A spare is used while recovery is in progress.
                    if [ "$action" = "recover" ] &&
                       printf '%s\n' "$state" |
                       grep -q 'spare'; then

                        echo REBUILD
                        return 0
                    fi

                    found_member=1

                    case "$state" in
                        *faulty*|*blocked*|*write_error*)
                            found_faulty=1
                            ;;
                    esac
                    ;;
            esac
        done
    done

    if [ "$found_faulty" -eq 1 ]; then
        echo FAULTY
        return 0
    fi

    if [ "$found_member" -eq 1 ]; then
        echo MEMBER
        return 0
    fi

    echo NONE
}

# ----------------------------------------------------------------------
# Return desired LED specification.
#
# Output:
#
#   off
#   blue
#   red
#   blink-red 1.0
#   blink-purple 1.0
# ----------------------------------------------------------------------

desired_led()
{
    bay="$1"
    ata="$2"

    disk=$(find_disk_for_ata "$ata")

    # Physical disk absent.
    if [ -z "$disk" ]; then
        echo "off"
        return
    fi

    raid=$(raid_state_for_disk "$disk")

    # Rebuild/recovery always has highest priority.
    if [ "$raid" = "REBUILD" ]; then
        echo "blink-purple $REBUILD_PERIOD"
        return
    fi

    # Disk is present but RAID has marked it faulty.
    if [ "$raid" = "FAULTY" ]; then
        echo "red"
        return
    fi

    # SMART is relevant to active RAID members.
    #
    # If no RAID array is currently assembled, still report SMART
    # status so a physically present healthy disk is blue.
    smart=$(smart_status "/dev/$disk")

    if [ "$smart" = "BAD" ]; then
        echo "blink-red $SMART_BLINK_PERIOD"
        return
    fi

    # Active RAID member and SMART OK.
    if [ "$raid" = "MEMBER" ]; then
        echo "blue"
        return
    fi

    # A physically present disk which is not currently part of an
    # assembled RAID is shown blue when SMART is OK.
    echo "blue"
}

# ----------------------------------------------------------------------
# Apply one LED only when its state actually changed.
# ----------------------------------------------------------------------

apply_bay()
{
    bay="$1"
    ata="$2"
    state="$3"

    state_file="$RUNTIME_DIR/bay$bay.state"

    old=""

    if [ -f "$state_file" ]; then
        old=$(cat "$state_file" 2>/dev/null)
    fi

    if [ "$old" = "$state" ]; then
        return
    fi

    case "$state" in
        off)
            "$H340LED" "hdd$bay" off
            ;;

        blue)
            "$H340LED" "hdd$bay" blue
            ;;

        red)
            "$H340LED" "hdd$bay" red
            ;;

        "blink-red "*)
            period=${state#blink-red }
            "$H340LED" "hdd$bay" blink-red "$period"
            ;;

        "blink-purple "*)
            period=${state#blink-purple }
            "$H340LED" "hdd$bay" blink-purple "$period"
            ;;

        *)
            log_msg "ERROR: invalid bay$bay state: $state"
            return
            ;;
    esac

    printf '%s\n' "$state" > "$state_file"

    log_msg "BAY$bay ($ata): $old -> $state"
}

# ----------------------------------------------------------------------
# Check all four bays.
# ----------------------------------------------------------------------

update_bays()
{
    state1=$(desired_led 1 ata1)
    state2=$(desired_led 2 ata2)
    state3=$(desired_led 3 ata3)
    state4=$(desired_led 4 ata4)

    apply_bay 1 ata1 "$state1"
    apply_bay 2 ata2 "$state2"
    apply_bay 3 ata3 "$state3"
    apply_bay 4 ata4 "$state4"
}

# ----------------------------------------------------------------------
# Signal handling
# ----------------------------------------------------------------------

stop_monitor()
{
    RUNNING=0
}

trap stop_monitor TERM INT

# ----------------------------------------------------------------------
# Startup
# ----------------------------------------------------------------------

mkdir -p "$RUNTIME_DIR"

log_msg "starting"

# Start the LED daemon if it is not already running.
#
# h340led has its own daemon lock, so starting it here is safe even
# when another instance is already supervised elsewhere.
if ! pidof h340led >/dev/null 2>&1; then
    "$H340LED" daemon >/dev/null 2>&1 &
    sleep 1
fi

# Force our four bay LEDs off before the first evaluation.
"$H340LED" all off

rm -f \
    "$RUNTIME_DIR/bay1.state" \
    "$RUNTIME_DIR/bay2.state" \
    "$RUNTIME_DIR/bay3.state" \
    "$RUNTIME_DIR/bay4.state"

# ----------------------------------------------------------------------
# Main loop
# ----------------------------------------------------------------------

while [ "$RUNNING" -eq 1 ]; do
    update_bays
    sleep_1s
done

# ----------------------------------------------------------------------
# Shutdown
# ----------------------------------------------------------------------

log_msg "stopping"

"$H340LED" all off

rm -f \
    "$RUNTIME_DIR/bay1.state" \
    "$RUNTIME_DIR/bay2.state" \
    "$RUNTIME_DIR/bay3.state" \
    "$RUNTIME_DIR/bay4.state"

exit 0
